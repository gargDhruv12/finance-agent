GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
DRY_RUN=true
REQUIRE_APPROVAL=true
SENDER_EMAIL=finance@example.com
PAYMENT_BASE_URL=https://payments.example.com/pay
AUDIT_DB_PATH=outputs/audit_log.sqlite
CACHE_DB_PATH=outputs/llm_cache.sqlite
APPROVALS_PATH=outputs/approvals.json
ENABLE_LOCAL_TRACING=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=finance-credit-follow-up-agent
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
SCHEDULER_INTERVAL_HOURS=24
